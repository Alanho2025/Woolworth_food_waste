# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Contract: foodflow_clean_code_spec.md section 6.4

# --- DeepSeek ---------------------------------------------------------------
# deepseek-v4-flash is the current generation. The legacy deepseek-chat and
# deepseek-reasoner aliases still resolve (verified by live probe 2026-08-08)
# but are on a deprecation path. deepseek-v4-pro costs roughly 3.1x.
#
# NOTE: v4-flash runs with THINKING ENABLED BY DEFAULT and returns
# reasoning_content, which the no-chain-of-thought rules forbid retaining.
# The adapter disables it explicitly. Do not remove that.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Persistence ------------------------------------------------------------
DATABASE_URL=sqlite:///./foodflow.db

# --- Demo behaviour ---------------------------------------------------------
# Pins the clock to 2026-08-08T15:45+12:00 and uses the seeded world.
# Without it, receiving-window checks run against real wall-clock time and every
# community is correctly closed outside 16:00-19:00 NZ, which kills the demo.
DEMO_MODE=true

# Deliberately separate from DEMO_MODE: one boolean driving both the clock and
# the model transport would make the combination rehearsal actually needs --
# live model, pinned clock -- unreachable.
# live   = real DeepSeek calls
# replay = deterministic recorded fixtures, no API key required
AGENT_TRANSPORT=replay

# --- Agent bounds -----------------------------------------------------------
# ADK's RunConfig.max_llm_calls defaults to 500; a runaway loop would make 500
# DeepSeek calls before stopping. RunConfig has no timeout fields at all, so the
# two below are enforced in application code.
AGENT_MAX_LLM_CALLS=24
AGENT_RUN_TIMEOUT_SECONDS=90
AGENT_TOOL_TIMEOUT_SECONDS=10
