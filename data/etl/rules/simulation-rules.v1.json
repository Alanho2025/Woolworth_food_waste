{
  "version": "simulation-rules.v1",
  "scenario_tables": [
    "source_records",
    "users",
    "organisation_memberships",
    "site_locations",
    "food_products",
    "donations",
    "donation_items",
    "food_condition_observations",
    "donation_status_events",
    "recipient_capabilities",
    "recipient_needs",
    "recipient_availability_snapshots",
    "match_runs",
    "match_candidates",
    "match_decisions",
    "allocations",
    "allocation_status_events",
    "route_planning_runs",
    "route_input_snapshots",
    "route_proposals",
    "route_decisions",
    "deliveries",
    "delivery_stops",
    "delivery_allocations",
    "delivery_status_events"
  ],
  "rules": [
    {
      "rule_id": "sim-source-records-v1",
      "target_fields": ["source_records.id", "source_records.import_batch_id", "source_records.source_system", "source_records.source_record_type", "source_records.external_record_id", "source_records.observed_at", "source_records.recorded_at", "source_records.raw_reference", "source_records.raw_payload", "source_records.ingest_status", "source_records.ingest_message"],
      "evidence_ids": ["schema-source", "ev-store-locator", "ev-mpi-recalls"],
      "calibration_method": "Deterministic graph identifiers and bounded source-envelope values; unavailable source observations remain unknown.",
      "allowed_values_or_range": {"structural": "UUID5 and schema-valid foreign keys", "semantic": "source-backed or unknown"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "high",
      "limitations": ["This rule does not create an observed snapshot or invent an external source payload."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-users-v1",
      "target_fields": ["users.id", "users.display_name", "users.email", "users.password_hash", "users.oauth_provider", "users.oauth_subject", "users.status", "users.created_at", "users.updated_at"],
      "evidence_ids": ["schema-user"],
      "calibration_method": "Pseudonymous scenario actors with deterministic identifiers and non-secret authentication fields.",
      "allowed_values_or_range": {"identity": "scenario-only pseudonyms", "credentials": null},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "high",
      "limitations": ["Actors are not real users and no protected identity or credential is generated."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-memberships-v1",
      "target_fields": ["organisation_memberships.id", "organisation_memberships.user_id", "organisation_memberships.organisation_id", "organisation_memberships.site_id", "organisation_memberships.scope_type", "organisation_memberships.membership_role", "organisation_memberships.valid_from", "organisation_memberships.valid_until", "organisation_memberships.created_at"],
      "evidence_ids": ["schema-user", "schema-site"],
      "calibration_method": "Deterministic scenario actor membership graph with bounded validity windows.",
      "allowed_values_or_range": {"membership": "scenario-operational roles only"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "medium",
      "limitations": ["Memberships represent simulated permissions and do not establish real authorization."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-site-locations-v1",
      "target_fields": ["site_locations.id", "site_locations.site_id", "site_locations.location_type", "site_locations.precision_level", "site_locations.verification_status", "site_locations.visibility", "site_locations.address_line1", "site_locations.suburb", "site_locations.city", "site_locations.region", "site_locations.postal_code", "site_locations.country_code", "site_locations.latitude", "site_locations.longitude", "site_locations.valid_from", "site_locations.valid_until", "site_locations.verified_at", "site_locations.created_at"],
      "evidence_ids": ["schema-site", "ev-store-locator", "ev-kiwiharvest-recipients"],
      "calibration_method": "Reuse source-backed public coordinates for reference rows and explicitly separate a scenario-operational row without coordinate jitter.",
      "allowed_values_or_range": {"public": "source-backed public coordinate", "operational": "scenario-only operator_confirmed assertion"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "medium",
      "limitations": ["A public coordinate is not a loading or receiving entrance; operator_confirmed is scenario-only."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-food-products-v1",
      "target_fields": ["food_products.id", "food_products.gtin", "food_products.product_name", "food_products.brand", "food_products.variant", "food_products.source_record_id", "food_products.created_at", "food_products.updated_at"],
      "evidence_ids": ["schema-source", "ev-gs1-barcode", "ev-food-policy"],
      "calibration_method": "Use a bounded product identity with one barcode-present and one barcode-absent scenario branch.",
      "allowed_values_or_range": {"barcode": "present or null", "identity": "policy-compatible scenario product"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "medium",
      "limitations": ["A barcode example does not prove product-master membership or recall clearance."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-donations-v1",
      "target_fields": ["donations.id", "donations.source_site_id", "donations.created_by_user_id", "donations.source_record_id", "donations.pickup_window_start", "donations.pickup_window_end", "donations.safe_deadline", "donations.status", "donations.created_at", "donations.updated_at"],
      "evidence_ids": ["schema-supply", "ev-mpi-donation", "ev-kiwiharvest-branches", "schema-site"],
      "calibration_method": "Independent bounded donation quantity and deterministic timeline derived from scenario as-of and seed.",
      "allowed_values_or_range": {"timeline": "pickup window precedes safe deadline", "quantity": "independent historical-scale ceiling"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "medium",
      "limitations": ["No live donor event, quantity, pickup commitment, or operational deadline is claimed."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-donation-items-v1",
      "target_fields": ["donation_items.id", "donation_items.donation_id", "donation_items.line_number", "donation_items.food_product_id", "donation_items.product_name_snapshot", "donation_items.brand_snapshot", "donation_items.variant_snapshot", "donation_items.gtin_snapshot", "donation_items.lot_code", "donation_items.quantity", "donation_items.quantity_unit", "donation_items.storage_class", "donation_items.date_mark_type", "donation_items.date_mark", "donation_items.packaging_condition", "donation_items.recall_status", "donation_items.created_at"],
      "evidence_ids": ["schema-supply", "ev-mpi-labels", "ev-mpi-recalls", "ev-food-policy"],
      "calibration_method": "Create barcode and no-barcode item branches; apply independent quantity ceiling and conservative recall state.",
      "allowed_values_or_range": {"recall_status": ["not_checked", "not_recalled"], "capacity_relation": "quantity does not calibrate capacity"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "medium",
      "limitations": ["Recall is not_checked when no deterministic as-of identifier match exists; no-match is not a safety claim."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-condition-observations-v1",
      "target_fields": ["food_condition_observations.id", "food_condition_observations.donation_item_id", "food_condition_observations.observed_by_user_id", "food_condition_observations.checkpoint", "food_condition_observations.condition_status", "food_condition_observations.temperature_celsius", "food_condition_observations.notes", "food_condition_observations.observed_at", "food_condition_observations.recorded_at"],
      "evidence_ids": ["schema-supply", "ev-mpi-donation"],
      "calibration_method": "Scenario-only condition checkpoints constrained by published safety guidance and deterministic timeline.",
      "allowed_values_or_range": {"status": "schema enum", "temperature": "bounded where the scenario explicitly represents it"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "low",
      "limitations": ["These are simulated observations and are not an inspection or temperature log."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-donation-events-v1",
      "target_fields": ["donation_status_events.id", "donation_status_events.donation_id", "donation_status_events.event_type", "donation_status_events.actor_type", "donation_status_events.actor_user_id", "donation_status_events.occurred_at", "donation_status_events.recorded_at", "donation_status_events.notes"],
      "evidence_ids": ["schema-supply", "schema-user"],
      "calibration_method": "Deterministic scenario lifecycle events with an explicit simulated actor.",
      "allowed_values_or_range": {"lifecycle": "schema-valid donation transitions"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "medium",
      "limitations": ["Events are not real operational history or proof of donor action."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-recipient-capabilities-v1",
      "target_fields": ["recipient_capabilities.id", "recipient_capabilities.site_id", "recipient_capabilities.food_category", "recipient_capabilities.storage_class", "recipient_capabilities.visibility", "recipient_capabilities.valid_from", "recipient_capabilities.valid_until", "recipient_capabilities.updated_by_user_id", "recipient_capabilities.notes", "recipient_capabilities.created_at"],
      "evidence_ids": ["schema-recipient", "ev-food-policy"],
      "calibration_method": "Policy-bounded capability branch with explicit known versus unknown operational state.",
      "allowed_values_or_range": {"capacity": "known or unknown; no inferred live volume"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "medium",
      "limitations": ["Policy scope does not establish current receiving capacity or a specific site's acceptance."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-recipient-needs-v1",
      "target_fields": ["recipient_needs.id", "recipient_needs.site_id", "recipient_needs.food_category", "recipient_needs.storage_class", "recipient_needs.quantity", "recipient_needs.quantity_unit", "recipient_needs.priority", "recipient_needs.receiving_window_start", "recipient_needs.receiving_window_end", "recipient_needs.valid_from", "recipient_needs.valid_until", "recipient_needs.visibility", "recipient_needs.updated_by_user_id", "recipient_needs.created_at"],
      "evidence_ids": ["schema-recipient", "ev-kiwiharvest-recipients", "ev-food-policy"],
      "calibration_method": "Bounded scenario need with a separate negative branch and no claim of live recipient demand.",
      "allowed_values_or_range": {"priority": "schema range", "quantity": "bounded scenario need"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "low",
      "limitations": ["Public relationship evidence does not prove current quantity need or receiving approval."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-recipient-availability-v1",
      "target_fields": ["recipient_availability_snapshots.id", "recipient_availability_snapshots.site_id", "recipient_availability_snapshots.food_category", "recipient_availability_snapshots.storage_class", "recipient_availability_snapshots.capacity_status", "recipient_availability_snapshots.available_quantity", "recipient_availability_snapshots.quantity_unit", "recipient_availability_snapshots.receiving_window_start", "recipient_availability_snapshots.receiving_window_end", "recipient_availability_snapshots.observed_at", "recipient_availability_snapshots.recorded_at", "recipient_availability_snapshots.valid_from", "recipient_availability_snapshots.valid_until", "recipient_availability_snapshots.visibility", "recipient_availability_snapshots.updated_by_user_id", "recipient_availability_snapshots.source_record_id"],
      "evidence_ids": ["schema-recipient", "ev-kiwiharvest-recipients"],
      "calibration_method": "Emit both known-capacity and unknown-capacity snapshots without deriving capacity from donation quantity.",
      "allowed_values_or_range": {"capacity_status": ["known", "unknown"], "available_quantity": "null when unknown"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "low",
      "limitations": ["Availability is a scenario state; public candidate evidence does not establish live capacity."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-match-runs-v1",
      "target_fields": ["match_runs.id", "match_runs.donation_item_id", "match_runs.requested_by_user_id", "match_runs.policy_version", "match_runs.model_identifier", "match_runs.status", "match_runs.started_at", "match_runs.completed_at"],
      "evidence_ids": ["schema-matching", "schema-user"],
      "calibration_method": "Deterministic matching run envelope with a named policy and scenario actor.",
      "allowed_values_or_range": {"status": "schema-valid lifecycle"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "high",
      "limitations": ["The run is scenario evidence for product behavior, not a model performance evaluation."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-match-candidates-v1",
      "target_fields": ["match_candidates.id", "match_candidates.match_run_id", "match_candidates.recipient_site_id", "match_candidates.feasibility_status", "match_candidates.reason_code", "match_candidates.reason_components", "match_candidates.agent_rank", "match_candidates.priority_score", "match_candidates.evaluated_at"],
      "evidence_ids": ["schema-matching", "schema-recipient", "ev-food-policy"],
      "calibration_method": "Construct one feasible and one negative candidate branch using explicit reason components.",
      "allowed_values_or_range": {"branch": ["feasible", "rejected"], "score": "scenario-only bounded score"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "low",
      "limitations": ["Candidate scores and reasons are illustrative and do not claim real matching quality."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-match-decisions-v1",
      "target_fields": ["match_decisions.id", "match_decisions.match_candidate_id", "match_decisions.decision_type", "match_decisions.decision", "match_decisions.actor_user_id", "match_decisions.decided_at", "match_decisions.comment"],
      "evidence_ids": ["schema-matching", "schema-user"],
      "calibration_method": "Two-branch scenario with an explicit human match decision gate.",
      "allowed_values_or_range": {"decision": "scenario approval or rejection"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "medium",
      "limitations": ["operator_confirmed semantics exist only inside the simulated world and are not real approval."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-allocations-v1",
      "target_fields": ["allocations.id", "allocations.donation_item_id", "allocations.recipient_site_id", "allocations.match_candidate_id", "allocations.allocated_quantity", "allocations.quantity_unit", "allocations.status", "allocations.reserved_by_user_id", "allocations.reserved_at", "allocations.confirmed_by_user_id", "allocations.confirmed_at", "allocations.fulfilled_at"],
      "evidence_ids": ["schema-matching", "schema-supply", "schema-recipient"],
      "calibration_method": "Allocate within the independent donation quantity ceiling and known-capacity branch; unknown capacity remains unknown.",
      "allowed_values_or_range": {"quantity": "at most donation quantity ceiling", "capacity": "never inferred from allocation"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "medium",
      "limitations": ["Allocation is scenario-operational and not a real recipient commitment."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-allocation-events-v1",
      "target_fields": ["allocation_status_events.id", "allocation_status_events.allocation_id", "allocation_status_events.event_type", "allocation_status_events.actor_type", "allocation_status_events.actor_user_id", "allocation_status_events.occurred_at", "allocation_status_events.recorded_at", "allocation_status_events.notes"],
      "evidence_ids": ["schema-matching", "schema-user"],
      "calibration_method": "Deterministic allocation lifecycle with the human decision transition preserved.",
      "allowed_values_or_range": {"lifecycle": "schema-valid allocation transitions"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "medium",
      "limitations": ["Events are simulated audit history and do not establish a real transfer."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-route-planning-runs-v1",
      "target_fields": ["route_planning_runs.id", "route_planning_runs.driver_user_id", "route_planning_runs.planning_horizon_start", "route_planning_runs.planning_horizon_end", "route_planning_runs.planned_departure_at", "route_planning_runs.policy_version", "route_planning_runs.model_identifier", "route_planning_runs.status", "route_planning_runs.created_at"],
      "evidence_ids": ["schema-route", "schema-user"],
      "calibration_method": "Deterministic route planning envelope for a pickup-then-receiving topology.",
      "allowed_values_or_range": {"topology": ["pickup", "receiving"], "metrics": null},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "medium",
      "limitations": ["No route optimization or provider travel metric is claimed."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-route-input-snapshots-v1",
      "target_fields": ["route_input_snapshots.id", "route_input_snapshots.route_planning_run_id", "route_input_snapshots.input_kind", "route_input_snapshots.provider", "route_input_snapshots.coverage_reference", "route_input_snapshots.observed_at", "route_input_snapshots.recorded_at", "route_input_snapshots.valid_from", "route_input_snapshots.valid_until", "route_input_snapshots.payload", "route_input_snapshots.source_record_id"],
      "evidence_ids": ["schema-route", "schema-source"],
      "calibration_method": "Record only topology and source references available in Phase 0; provider travel inputs remain unknown.",
      "allowed_values_or_range": {"provider": "null without provider evidence", "payload": "bounded scenario metadata"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "low",
      "limitations": ["No network provider, travel-time observation, or route matrix is available in this phase."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-route-proposals-v1",
      "target_fields": ["route_proposals.id", "route_proposals.route_planning_run_id", "route_proposals.version", "route_proposals.proposal_status", "route_proposals.proposal_payload", "route_proposals.priority_reasons", "route_proposals.cost_components", "route_proposals.total_travel_seconds", "route_proposals.total_distance_meters", "route_proposals.created_at"],
      "evidence_ids": ["schema-route"],
      "calibration_method": "Represent pickup then receiving order while retaining unsupported route metrics as unknown.",
      "allowed_values_or_range": {"stops": ["pickup", "receiving"], "travel_metrics": null},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "low",
      "limitations": ["Route topology is not an optimization claim and provider metrics are not generated without evidence."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-route-decisions-v1",
      "target_fields": ["route_decisions.id", "route_decisions.route_proposal_id", "route_decisions.decision_type", "route_decisions.decision", "route_decisions.actor_user_id", "route_decisions.decided_at", "route_decisions.comment"],
      "evidence_ids": ["schema-route", "schema-user"],
      "calibration_method": "Explicit second human decision gate for the scenario route proposal.",
      "allowed_values_or_range": {"decision": "scenario approval or rejection"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "medium",
      "limitations": ["The route decision is scenario-only operator_confirmed semantics, not a real dispatch approval."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-deliveries-v1",
      "target_fields": ["deliveries.id", "deliveries.route_decision_id", "deliveries.driver_user_id", "deliveries.planned_departure_at", "deliveries.committed_at", "deliveries.status", "deliveries.started_at", "deliveries.completed_at"],
      "evidence_ids": ["schema-route", "schema-user"],
      "calibration_method": "Deterministic scenario delivery lifecycle after the route decision gate.",
      "allowed_values_or_range": {"lifecycle": "schema-valid delivery transitions"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "low",
      "limitations": ["No driver, vehicle, dispatch, or real delivery event is claimed."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-delivery-stops-v1",
      "target_fields": ["delivery_stops.id", "delivery_stops.delivery_id", "delivery_stops.stop_sequence", "delivery_stops.actual_sequence", "delivery_stops.stop_type", "delivery_stops.site_id", "delivery_stops.site_location_id", "delivery_stops.window_start", "delivery_stops.window_end", "delivery_stops.planned_arrival_at", "delivery_stops.planned_departure_at", "delivery_stops.actual_arrival_at", "delivery_stops.actual_departure_at", "delivery_stops.status", "delivery_stops.result_note"],
      "evidence_ids": ["schema-route", "schema-site", "ev-store-locator", "ev-kiwiharvest-recipients"],
      "calibration_method": "Create exactly a pickup stop then receiving stop; distinguish public source location from scenario-operational location.",
      "allowed_values_or_range": {"stop_order": ["pickup", "receiving"], "coordinates": "reuse source-backed public coordinate only"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "low",
      "limitations": ["A scenario operational stop is not evidence of a real entrance or a navigable route."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-delivery-allocations-v1",
      "target_fields": ["delivery_allocations.id", "delivery_allocations.delivery_id", "delivery_allocations.allocation_id", "delivery_allocations.pickup_stop_id", "delivery_allocations.delivery_stop_id"],
      "evidence_ids": ["schema-route", "schema-matching"],
      "calibration_method": "Deterministic junction connecting one scenario allocation to pickup and receiving stops.",
      "allowed_values_or_range": {"topology": "one pickup and one receiving stop"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "high",
      "limitations": ["The junction is a schema-valid scenario graph and not a real assignment."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    },
    {
      "rule_id": "sim-delivery-events-v1",
      "target_fields": ["delivery_status_events.id", "delivery_status_events.delivery_id", "delivery_status_events.stop_id", "delivery_status_events.event_type", "delivery_status_events.actor_type", "delivery_status_events.actor_user_id", "delivery_status_events.occurred_at", "delivery_status_events.recorded_at", "delivery_status_events.notes"],
      "evidence_ids": ["schema-route", "schema-user"],
      "calibration_method": "Deterministic scenario delivery and stop lifecycle events with explicit simulated actor.",
      "allowed_values_or_range": {"lifecycle": "schema-valid delivery transitions"},
      "unit": "schema field",
      "timezone": "Pacific/Auckland",
      "confidence": "low",
      "limitations": ["Events are simulated audit records and are not proof a delivery occurred."],
      "seed_namespace": "kiwiharvest-realistic-demo-v1",
      "version": "v1"
    }
  ]
}
