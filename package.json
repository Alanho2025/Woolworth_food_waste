{
  "name": "foodflow-platform-foundation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "uv run alembic upgrade head",
    "db:migrate:check": "uv run alembic check",
    "dev:backend": "./scripts/dev_backend.sh",
    "dev:frontend": "npm --prefix frontend run dev",
    "backend:test": "uv run pytest backend/tests",
    "frontend:format": "npm --prefix frontend run format:check",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "frontend:test": "npm --prefix frontend test",
    "quality": "./scripts/quality_gate.sh"
  }
}
